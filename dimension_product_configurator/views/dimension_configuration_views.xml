<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_cpq_configuration_list" model="ir.ui.view">
    <field name="name">dimension_config.configuration.list</field>
    <field name="model">dimension_config.configuration</field>
    <field name="arch" type="xml">
      <tree string="Configurations" create="false">
        <field name="sale_line_id"/>
        <field name="dim_product_id"/>
        <field name="summary"/>
        <field name="weight_kg" string="Weight (kg)"/>
        <field name="price_unit"/>
      </tree>
    </field>
  </record>

  <record id="action_dim_configuration" model="ir.actions.act_window">
    <field name="name">Configurations</field>
    <field name="res_model">dimension_config.configuration</field>
    <field name="view_mode">tree</field>
  </record>

</odoo>
